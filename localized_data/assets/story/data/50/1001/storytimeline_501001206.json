    "no_wrap": false,
    "text_block_list": [
        {
            "name": "",
            "text": "Наконец-то настал день Arima Kinen."
        },
        {
            "name": "Спешл Уик",
            "text": "Привет, Грасс!"
        },
        {
            "name": "Грасс Вандер",
            "text": "Ах... Привет, Спе."
        },
        {
            "name": "Грасс Вандер",
            "text": "Хе-хе, сегодня тот самый день."
        },
        {
            "name": "Спешл Уик",
            "text": "...Ага."
        },
        {
            "name": "Спешл Уик",
            "text": "И... я выиграю."
        },
        {
            "name": "Грасс Вандер",
            "text": "...!"
        },
        {
            "name": "Спешл Уик",
            "text": "Я одолею тебя и стану лучшей Умой Японии! На кону\nпервое место, так что покажи всё, на что способна!"
        },
        {
            "name": "Грасс Вандер",
            "text": "...Хе-хе."
        },
        {
            "name": "Грасс Вандер",
            "text": "Ты же знаешь, что так и будет. Я буду состязаться\nс тобой изо всех сил."
        },
        {
            "name": "Спешл Уик",
            "text": "Отличненько... Поехали, Тренер!"
        }
    ]
}