{
    "localize_dict": "localize_dict1.json",
    "hashed_dict": "hashed_dict.json",
    "text_data_dict": "text_data_dict.json",
    "character_system_text_dict": "character_system_text_dict.json",
    "race_jikkyo_comment_dict": "race_jikkyo_comment_dict.json",
    "race_jikkyo_message_dict": "race_jikkyo_message_dict.json",
    "assets_dir": "assets",
    "extra_asset_bundle": {"windows": "font2", "android": "font3"},
    "replacement_font_name": "assets/fonts/umaopensansrodinex-extrabold2.ttf",

    "plural_form": "n == 1 ? 0 : 1",
    "ordinal_form": "(((n+9)%10)<3 && ((n+90)%100)>10) ? ((n+9)%10) : 3",
    "ordinal_types": ["$-ое", "$-ое", "$-ье", "$-ое", "-ое", "-ое", "-ое", "-ое", "-ое", "-ое"],
    "months": ["Янв.", "Фев.", "Мар.", "Апр.", "Май.", "Июнь.", "Июль.", "Авг.", "Сен.", "Окт.", "Ноя.", "Дек."],
    "month_text_format": "$(half) $(month)",
    
    "text_wrapper": 1,
    "use_text_wrapper": true,
    "line_width_multiplier": 2,

    "auto_adjust_story_clip_length": true,
    "story_line_count_offset": 1,
    "text_frame_line_spacing_multiplier": 0.52,
    "text_frame_font_size_multiplier": 0.75,
    "skill_list_item_desc_font_size_multiplier": 0.5,
    "now_loading_comic_title_ellipsis": true,

    "remove_ruby": true,
    "character_note_top_gallery_button": {
        "text": "$(nb)Ивенты\nКарьеры",
        "font_size": 38,
        "line_spacing": 0.6
    },
    "character_note_top_talk_gallery_button": {
        "text": "$(nb)Диалоги\nОбжещития",
        "font_size": 44,
        "line_spacing": 0.55
    },

    "news_url": ""
}
